{
  "expo": {
    "name": "Study Streak Garden",
    "slug": "study-streak-garden",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF3E7",
    "icon": "./assets/icon.png",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.studystreakgarden",
      "icon": "./assets/icon.png"
    },

    "android": {
      "package": "com.example.studystreakgarden",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAF3E7"
      }
    },

    "plugins": [
      ["expo-notifications", { "color": "#8E7CC3" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo from your library.",
          "cameraPermission": "Take a profile photo."
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-asset"
    ]
  }
}